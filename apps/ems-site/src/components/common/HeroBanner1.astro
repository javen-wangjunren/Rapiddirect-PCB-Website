---
import { getAssetPath } from '../../lib/assets';

export interface Props {
  data: {
    title: string;
    description: string;
    image_url: string;
    image_url_secondary?: string;
  };
}

const { data } = Astro.props;

const primaryImage = data.image_url ? getAssetPath(data.image_url) : '';
const secondaryImage = data.image_url_secondary ? getAssetPath(data.image_url_secondary) : '';
---

<section class="bg-[#F8F8F8]">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:py-24">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-center lg:gap-16">
      <!-- Left: title + description -->
      <div class="max-w-lg flex-1">
        <h1 class="text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
          {data.title}
        </h1>
        <p class="mt-6 text-base leading-7 text-slate-600">
          {data.description}
        </p>
      </div>

      <!-- Right: 4:3 images with overlap -->
      <div class="relative w-full lg:w-[55%]">
        {
          secondaryImage && (
            <div class="absolute -top-4 right-0 z-10 w-[45%] overflow-hidden rounded-2xl shadow-lg lg:-top-6">
              <img
                src={secondaryImage}
                alt=""
                class="aspect-[4/3] w-full object-cover"
                loading="eager"
                decoding="async"
              />
            </div>
          )
        }
        {
          primaryImage && (
            <div class="relative overflow-hidden rounded-2xl shadow-lg">
              <img
                src={primaryImage}
                alt=""
                class="aspect-[4/3] w-full object-cover"
                loading="eager"
                decoding="async"
              />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
