---
import type { NavItemData } from '../../content/schemas/site-header';
const { item } = Astro.props as { item: NavItemData };
---

<div class="mega-menu absolute top-full left-1/2 -translate-x-1/2 translate-y-2.5 w-full max-w-[1280px] bg-[#1C1C1C] rounded-b-[20px] shadow-[0_20px_40px_rgba(0,0,0,0.2)] opacity-0 invisible pointer-events-none transition-all duration-300 flex overflow-hidden z-[999]">
  <div class="menu-body menu-body-resources flex-1 p-8 grid grid-cols-3 gap-7">
    {item.resource_sections?.map((section) => {
      const isService = section.link_style === 'service';
      return (
        <div class="resources-section min-w-0">
          <div class="text-lg font-bold text-[#EA543F] pb-3 border-b-2 border-[rgba(255,255,255,0.14)] mb-5">{section.section_title}</div>

          {isService && section.service_items && section.service_items.length > 0 && (
            <div class="materials-service flex flex-col gap-2.5 mb-5">
              {section.service_items.map((item) => (
                <a href={item.href || '#'} class="service-item flex flex-col gap-[3px] px-3 py-2.5 rounded-md bg-transparent border border-transparent no-underline hover:bg-[rgba(255,255,255,0.04)] hover:border-[rgba(255,255,255,0.08)] transition-all">
                  <span class="service-title text-sm font-[550] text-[#F5F5F5] hover:text-[#EA543F] transition-colors">{item.title}</span>
                  <span class="service-desc text-xs leading-relaxed text-[#9A9A9A]">{item.desc}</span>
                </a>
              ))}
            </div>
          )}

          {!isService && section.links && section.links.length > 0 && (
            <ul class="menu-list list-none m-0 p-0 mb-5">
              {section.links.map((link) => (
                <li class="mb-3">
                  <a href={link.href || '#'} class="text-[#F5F5F5] no-underline text-sm hover:text-[#EA543F] hover:translate-x-[5px] transition-all inline-block">{link.label}</a>
                </li>
              ))}
            </ul>
          )}

          {section.footer_label && section.footer_href && (
            <a href={section.footer_href} class="text-sm text-[#EA543F] no-underline font-semibold hover:underline hover:translate-x-[5px] transition-all inline-block">{section.footer_label} →</a>
          )}
        </div>
      );
    })}
  </div>
</div>