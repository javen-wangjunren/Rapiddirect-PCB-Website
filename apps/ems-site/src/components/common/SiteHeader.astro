  aria-modal="true"
>
  <label class="absolute inset-0 bg-slate-900/40" for="ems-site-mobile-menu-toggle" aria-label="Close menu"></label>
  <div class="mobile-menu-panel absolute right-0 top-0 h-full w-[82vw] max-w-[380px] translate-x-full bg-white text-slate-900 shadow-[-20px_0_60px_rgba(15,23,42,0.18)] transition-transform duration-300 ease-out">
    <div class="flex h-16 items-center justify-between border-b border-slate-200 px-5">
      <div class="text-lg font-semibold tracking-tight">Menu</div>
      <label for="ems-site-mobile-menu-toggle" class="inline-flex h-10 w-10 items-center justify-center rounded border border-slate-200 text-slate-900 hover:bg-slate-50 cursor-pointer" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6l-12 12" />
        </svg>
      </label>
    </div>
    <div class="h-[calc(100vh-4rem)] overflow-y-auto px-5 pb-6 pt-4">
      <nav class="flex flex-col">
        {navItems.map((item) => (
          <a href={item.href || '#'} class="border-b border-slate-200 py-4 text-base font-semibold text-slate-900 hover:bg-slate-50 hover:text-[#EA543F] no-underline">
            {item.label}
          </a>
        ))}
      </nav>
      <div class="mt-6">
        <a href={getHref(ctaHref)} class="block w-full rounded-xl bg-[#EA543F] px-6 py-3.5 text-center text-base font-bold text-white no-underline hover:bg-[#D84A36] transition-colors">
          {ctaText}
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ═══ 样式 ═══ -->
<style>
  /* 顶部通知栏 */
  .lang-selector:hover .lang-menu,
  .lang-selector:focus-within .lang-menu {
    display: flex;
  }

  /* 导航栏 */
  .nav-item:hover > .nav-item-link {
    color: #EA543F;
  }
  .has-dropdown:hover .dropdown-icon {
    transform: rotate(180deg);
  }

  /* Mega Menu 展开 */
  .has-dropdown:hover .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  /* Capabilities Panel 显示 */
  .cap-panel.is-active {
    display: block !important;
  }
  .cap-visual-img.is-active {
    display: block !important;
  }
  .cap-tab.is-active {
    color: #FFFFFF !important;
    border-left-color: rgba(234,84,63,0.9) !important;
    background: rgba(255,255,255,0.018);
  }

  /* Solutions Panel 显示 */
  .sol-panel.is-active {
    display: block !important;
  }
  .sol-visual-img.is-active {
    display: block !important;
  }
  .sol-tab.is-active {
    color: #FFFFFF !important;
    border-left-color: rgba(234,84,63,0.9) !important;
    background: rgba(255,255,255,0.018);
  }

  /* 移动端 */
  .mobile-menu details[open] summary svg {
    transform: rotate(180deg);
  }
</style>

<style is:global>
  body:has(#ems-site-mobile-menu-toggle:checked) {
    overflow: hidden;
  }
</style>

<!-- ═══ JavaScript ═══ -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Capabilities tab 切换
    const capTabs = document.querySelectorAll('.cap-tab[data-cap-tab]');
    const capPanels = document.querySelectorAll('.cap-panel[data-cap-panel]');
    const capVisuals = document.querySelectorAll('.cap-visual-img[data-cap-visual]');

    const activateCapTab = (tabKey: string) => {
      capTabs.forEach(tab => {
        const isActive = tab.getAttribute('data-cap-tab') === tabKey;
        tab.classList.toggle('is-active', isActive);
      });
      capPanels.forEach(panel => {
        panel.classList.toggle('is-active', panel.getAttribute('data-cap-panel') === tabKey);
      });
      capVisuals.forEach(img => {
        img.classList.toggle('is-active', img.getAttribute('data-cap-visual') === tabKey);
      });
    };

    capTabs.forEach(tab => {
      const key = tab.getAttribute('data-cap-tab');
      if (key) {
        tab.addEventListener('mouseenter', () => activateCapTab(key));
        tab.addEventListener('focus', () => activateCapTab(key));
        tab.addEventListener('click', (e) => {
          e.preventDefault();
          activateCapTab(key);
        });
      }
    });

    // Solutions tab 切换
    const solTabs = document.querySelectorAll('.sol-tab[data-sol-tab]');
    const solPanels = document.querySelectorAll('.sol-panel[data-sol-panel]');
    const solVisuals = document.querySelectorAll('.sol-visual-img[data-sol-visual]');

    const activateSolTab = (tabKey: string) => {
      solTabs.forEach(tab => {
        const isActive = tab.getAttribute('data-sol-tab') === tabKey;
        tab.classList.toggle('is-active', isActive);
      });
      solPanels.forEach(panel => {
        panel.classList.toggle('is-active', panel.getAttribute('data-sol-panel') === tabKey);
      });
      solVisuals.forEach(img => {
        img.classList.toggle('is-active', img.getAttribute('data-sol-visual') === tabKey);
      });
    };

    solTabs.forEach(tab => {
      const key = tab.getAttribute('data-sol-tab');
      if (key) {
        tab.addEventListener('mouseenter', () => activateSolTab(key));
        tab.addEventListener('focus', () => activateSolTab(key));
        tab.addEventListener('click', (e) => {
          e.preventDefault();
          activateSolTab(key);
        });
      }
    });
  });
</script>